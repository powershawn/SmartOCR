# 固定 Compose 專案名稱，確保重新部署沿用相同 named volumes
COMPOSE_PROJECT_NAME=smartocr
# 本機預設使用 8080；EC2 部署改為 80
FRONTEND_PORT=8080

# 請從 Google Cloud Console 建立「Web 應用程式」OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# 此信箱第一次用 Google 登入後會自動成為最高管理員
SUPER_ADMIN_EMAIL=admin@example.com
VITE_SUPER_ADMIN_EMAIL=admin@example.com
JWT_SECRET=please-change-this-to-a-long-random-string

# 本機體驗用；正式環境請設為 false
ALLOW_DEV_LOGIN=true
VITE_ALLOW_DEV_LOGIN=true

# 可選：自訂已 fine-tune 的 PaddleOCR 模型路徑
# 將 fine-tune 後的 inference model 放進 ./models，再取消下列註解
# OCR_DET_MODEL_DIR=/app/models/det
# OCR_REC_MODEL_DIR=/app/models/rec
